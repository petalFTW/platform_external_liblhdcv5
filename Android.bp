package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_ffi_static {
    name: "liblhdcv5_encoder_rust",
    crate_name: "lhdcv5_encoder",
    crate_root: "src/lib.rs",
    edition: "2021",
    vendor_available: true,
    host_supported: true,
    lints: "none",
    rustlibs: [
        "liblibc",
        "liblog_rust",
        "libthiserror",
        "libtracing",
        "libtracing_subscriber",
        "libzerocopy",
    ],
    target: {
        android: {
            rustlibs: [
                "libandroid_logger",
            ],
        },
        host: {
            rustlibs: [
                "libenv_logger",
            ],
        },
    },
    min_sdk_version: "36",
    apex_available: [
        "com.android.bt",
    ],
}

// Shared BT wrapper the a2dp stack dlopen()s as "liblhdcv5BT_enc.so".
// Bridges the Savitech lhdcv5BT_* API (source: DBeidachazi open-source impl) onto
// the Rust LHDC V5 core. Built shared (not static) because the stack loads it at
// runtime via dlopen/dlsym rather than link-time.
cc_library_shared {
    name: "liblhdcv5BT_enc",
    vendor_available: true,
    host_supported: true,
    export_include_dirs: [
        "include",
    ],
    srcs: [
        "src/lhdcv5BT_enc.c",
    ],
    whole_static_libs: [
        "liblhdcv5_encoder_rust",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    min_sdk_version: "36",
    apex_available: [
        "//apex_available:platform",
        "com.android.bt",
    ],
}
